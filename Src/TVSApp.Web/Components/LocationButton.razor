@using TVS_App.Application.DTOs.ServiceOrder
@using TVS_App.Application.Requests.ServiceOrderRequests.ServiceOrderCommands
@using TVSApp.Web.Handlers
@using TVSApp.Web.Models.ServiceOrders

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h6">Prateleira</MudText>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField Label="Local"
                          @bind-Value="Model.Location"
                          For="@(() => Model.Location)"
                          Variant="Variant.Outlined"
                          Style="flex: 1;" />

            @if (_isProcessing)
            {
                <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true" />
            }
            else
            {
                <MudButton OnClick="AdicionarPrateleira"
                           Disabled="_isProcessing"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add">
                    Adicionar
                </MudButton>
            }
        </MudStack>

        @if (!string.IsNullOrEmpty(ServiceOrder.Location))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                Prateleira atual: <strong>@ServiceOrder.Location</strong>
            </MudAlert>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter] public EventCallback OnLocationChanged { get; set; }
    [Parameter] public ServiceOrderDto ServiceOrder { get; set; } = null!;
    private AddProductLocationCommandModel Model { get; set; } = new();
    [Inject] public ServiceOrderHandler ServiceOrderHandler { get; set; } = null!;
    [Inject] public ISnackbar Snackbar { get; set; } = null!;

    private bool _isProcessing;

    public async Task AdicionarPrateleira()
    {
        try
        {
            _isProcessing = true;
            Model.ServiceOrderId = ServiceOrder.Id;

            var request = new AddProductLocationCommand(Model.ServiceOrderId, Model.Location);

            var result = await ServiceOrderHandler.AddProductLocation(request);
            if (result.IsSuccess)
            {
                Snackbar.Add("Prateleira adicionada com sucesso!", Severity.Success);
                await OnLocationChanged.InvokeAsync();
                Model.Location = string.Empty;
            }
            else
            {
                Snackbar.Add(result.Message ?? "Erro ao adicionar a prateleira", Severity.Error);
            }
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
