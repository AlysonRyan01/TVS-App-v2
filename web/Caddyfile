{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Métricas internas da API (Prometheus): só na rede do Docker, nunca pela internet.
	handle /api/internal/* {
		respond 404
	}

	# Grafana em /grafana no mesmo endereço do sistema (funciona só com o IP, sem DNS).
	# Sem strip do prefixo: o Grafana roda com serve_from_sub_path.
	redir /grafana /grafana/
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@static path *.js *.css *.woff2 *.png *.svg *.ico
	header @static Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}

# Opcional: Grafana num subdomínio próprio (precisa de DNS). Com ele, o Caddy emite o HTTPS sozinho.
{$GRAFANA_ADDRESS:grafana.localhost} {
	encode zstd gzip
	redir / /grafana/
	reverse_proxy grafana:3000
}
