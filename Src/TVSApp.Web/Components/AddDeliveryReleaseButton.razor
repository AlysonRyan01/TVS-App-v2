@using TVS_App.Application.DTOs.ServiceOrder
@using TVS_App.Application.Requests.ServiceOrderRequests.ServiceOrderCommands
@using TVSApp.Web.Handlers


<MudButton OnClick="AddDeliveryRelease" Disabled="_isProcessing" Size="Size.Large" IconColor="Color.Secondary" EndIcon="@Icons.Material.Filled.Done" Variant="Variant.Filled" Color="Color.Primary">
    <p class="text-white">@(@_isProcessing ? "Processando..." : "Liberado")</p>
</MudButton>

@code {
    [Parameter] public IMudDialogInstance DialogInstance { get; set; } = null!;
    [Parameter] public ServiceOrderDto ServiceOrder { get; set; } = null!;
    [Inject] public ServiceOrderHandler ServiceOrderHandler { get; set; } = null!;
    [Inject] public ISnackbar Snackbar { get; set; } = null!;

    private bool _isProcessing = false;
    public async Task AddDeliveryRelease()
    {
        try
        {
            _isProcessing = true;
            var result = await ServiceOrderHandler.MarkRejectedEstimateAsReadyToPickUp(
                new MarkEstimateRejectedAsReadyToPickUpCommand(ServiceOrder.Id));
            if (result.IsSuccess)
            {
                DialogInstance.Close(DialogResult.Ok(true));
                Snackbar.Add(result.Message ?? "Ordem pronta para retirada", Severity.Success);
            }
            else
                Snackbar.Add(result.Message?? "Erro ao adicionar a liberação", Severity.Error);
            
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }
}