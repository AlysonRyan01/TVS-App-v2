@using TVS_App.Application.DTOs.ServiceOrder
@using TVS_App.Application.Requests.ServiceOrderRequests.ServiceOrderCommands
@using TVS_App.Application.Requests.ServiceOrderRequests.ServiceOrdersQueries
@using TVS_App.Domain.Enums
@using TVSApp.Web.Extensions
@using TVSApp.Web.Handlers
@using TVSApp.Web.Models.ServiceOrders
@using TVSApp.Web.Components

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Color="Color.Primary">Adicionar Orçamento - OS @ServiceOrder.Id</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="4" Class="pa-2">
            <!-- EMPRESA -->
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>Empresa</strong></MudText>
                    <MudTextField Variant="Variant.Outlined" Label="Empresa" Value="@ServiceOrder.Enterprise.GetDisplayName()" ReadOnly="true" />
                </MudStack>
            </MudPaper>

            <!-- DADOS DO CLIENTE -->
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>Dados do Cliente</strong></MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Nome" Value="@ServiceOrder.Name" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Telefone 1" Value="@ServiceOrder.Phone" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Endereço" Value="@ServiceOrder.FormattedAddress" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Telefone 2" Value="@ServiceOrder.Phone2" ReadOnly="true" />
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudPaper>

            <!-- DADOS DO PRODUTO -->
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>Dados do Produto</strong></MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Tipo" Value="@ServiceOrder.Type.GetDisplayName()" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Marca" Value="@ServiceOrder.Brand" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Modelo" Value="@ServiceOrder.Model" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Série" Value="@ServiceOrder.SerialNumber" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Variant="Variant.Outlined" Label="Defeito" Value="@ServiceOrder.Defect" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Data de Entrada" Value="@ServiceOrder.EntryDate.ToString("dd/MM/yyyy")" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Situação" Value="@Situacao" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Variant="Variant.Outlined" Label="Prateleira" Value="@ServiceOrder.Location" ReadOnly="true" />
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudPaper>

            <!-- PRATELEIRA E PAGAMENTOS -->
            <MudGrid Spacing="4">
                <MudItem xs="12" md="6">
                    <LocationButton ServiceOrder="ServiceOrder" OnLocationChanged="UpdateLocation" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <PaymentComponent ServiceOrderId="ServiceOrder.Id" />
                </MudItem>
            </MudGrid>

            <!-- FORMULÁRIO DE ORÇAMENTO -->
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary"><strong>Adicionar Orçamento</strong></MudText>
                    <MudForm @ref="_form">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField Label="Solução" Lines="2" @bind-Value="Model.Solution" For="@(() => Model.Solution)" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Label="Mensagem de orçamento" Lines="2" @bind-Value="Model.EstimateMessage" For="@(() => Model.EstimateMessage)" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Label="Valor total" @bind-Value="Model.LaborCost" For="@(() => Model.LaborCost)" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField Label="Garantia" @bind-Value="Model.Guarantee" For="@(() => Model.Guarantee)" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudNumericField T="decimal" Label="Valor pago na peça" @bind-Value="Model.PartPurchaseCost"
                                                  For="@(() => Model.PartPurchaseCost)" Variant="Variant.Outlined"
                                                  Adornment="Adornment.Start" AdornmentText="R$" Min="0" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect Variant="Variant.Outlined" T="ERepairResult" Label="Situação" @bind-Value="Model.RepairResult" Color="Color.Primary">
                                    @foreach (var value in Enum.GetValues(typeof(ERepairResult)).Cast<ERepairResult>())
                                    {
                                        <MudSelectItem Value="@value">@GetPortugueseLabel(value)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    </MudForm>

                    <MudStack Row="true" Justify="Justify.FlexEnd">
                        @if (_isProcessing)
                        {
                            <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true" />
                        }
                        else
                        {
                            <MudButton OnClick="AdicionarOrcamento"
                                       Disabled="_isProcessing"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add">
                                Adicionar
                            </MudButton>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    private MudForm _form = null!;
    public AddServiceOrderEstimateCommandModel Model { get; set; } = new();
    private bool _isProcessing;

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ServiceOrderDto ServiceOrder { get; set; } = null!;
    [Inject] public ServiceOrderHandler ServiceOrderHandler { get; set; } = null!;
    [Inject] public ISnackbar Snackbar { get; set; } = null!;

    protected override Task OnInitializedAsync()
    {
        Model.RepairResult = ERepairResult.Repair;
        Model.PartPurchaseCost = ServiceOrder.PartPurchaseCost;
        return Task.CompletedTask;
    }

    public async Task AdicionarOrcamento()
    {
        try
        {
            await _form.Validate();

            if (!_form.IsValid)
            {
                Snackbar.Add("Preencha os campos obrigatórios corretamente.", Severity.Error);
                return;
            }

            _isProcessing = true;

            var request = new AddServiceOrderEstimateCommand(
                ServiceOrder.Id,
                Model.Guarantee,
                Model.Solution,
                Model.PartCost,
                Model.LaborCost,
                Model.RepairResult,
                Model.EstimateMessage,
                Model.PartPurchaseCost);

            var result = await ServiceOrderHandler.AddServiceOrderEstimate(request);

            if (result.IsSuccess)
            {
                MudDialog.Close(DialogResult.Ok(true));
                Snackbar.Add("Orçamento adicionado com sucesso!", Severity.Success);
            }
            else
                Snackbar.Add(result.Message ?? "Ocorreu um erro ao adicionar o orçamento!", Severity.Error);
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    public string Situacao =>
        ServiceOrder.ServiceOrderStatus switch
        {
            EServiceOrderStatus.Entered => "Avaliação pendente",
            EServiceOrderStatus.Evaluated => "Avaliado",
            EServiceOrderStatus.OrderPart => "Aguardando peça",
            EServiceOrderStatus.Repaired => "Consertado",
            EServiceOrderStatus.Delivered => "Entregue",
            _ => "Desconhecido"
        };

    private async Task UpdateLocation()
    {
        var command = new GetServiceOrderByIdQuery(ServiceOrder.Id);

        var result = await ServiceOrderHandler.GetServiceOrderById(command);
        if (result.IsSuccess)
        {
            if (result.Data != null)
            {
                ServiceOrder = ServiceOrder with { Location = result.Data.Location };
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Ocorreu um erro ao obter a ordem de serviço", Severity.Error);
            }
        }
    }

    private string GetPortugueseLabel(ERepairResult value)
    {
        return value switch
        {
            ERepairResult.Repair => "Tem conserto",
            ERepairResult.Unrepaired => "Não tem conserto",
            ERepairResult.NoDefectFound => "Não apresentou defeito",
            _ => value.ToString()
        };
    }
}
