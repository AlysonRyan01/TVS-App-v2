{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@static path *.js *.css *.woff2 *.png *.svg *.ico
	header @static Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
