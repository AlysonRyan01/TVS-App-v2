{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Métricas internas da API (Prometheus): só na rede do Docker, nunca pela internet.
	handle /api/internal/* {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@static path *.js *.css *.woff2 *.png *.svg *.ico
	header @static Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}

# Grafana (observabilidade). Com um subdomínio no GRAFANA_ADDRESS, o Caddy emite o HTTPS sozinho.
{$GRAFANA_ADDRESS:grafana.localhost} {
	encode zstd gzip
	reverse_proxy grafana:3000
}
