@page "/metricas"
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using TVS_App.Application.DTOs.Dashboard
@layout MainLayout
@attribute [Authorize]

<div class="flex flex-col min-h-[100vh] min-w-full p-4 gap-6">

    @if (_isBusy)
    {
        <div class="w-full flex justify-center items-center min-h-[60vh]">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        </div>
    }
    else if (_metrics is null)
    {
        <MudAlert Severity="Severity.Error">Não foi possível carregar as métricas.</MudAlert>
    }
    else
    {
        <!-- ── Título + Seletor de Período ──────────────────────────────────── -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-2">
            <div class="flex items-center gap-3">
                <MudIcon Icon="@Icons.Material.Filled.BarChart" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <p class="text-2xl font-bold font-sans text-[#750303]">Dashboard de Métricas</p>
                    <p class="text-sm text-gray-500 font-sans">@PeriodLabel</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <MudSelect T="int" Value="_selectedMonth" ValueChanged="OnMonthChanged"
                           Label="Mês" Variant="Variant.Outlined" Dense="true"
                           Style="min-width:150px" Disabled="_isBusy">
                    @foreach (var m in Months)
                    {
                        <MudSelectItem Value="@m.Value">@m.Label</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" Value="_selectedYear" ValueChanged="OnYearChanged"
                           Label="Ano" Variant="Variant.Outlined" Dense="true"
                           Style="min-width:100px" Disabled="_isBusy">
                    @foreach (var y in Years)
                    {
                        <MudSelectItem Value="@y">@y</MudSelectItem>
                    }
                </MudSelect>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                <MudDatePicker Label="De" Date="_rangeStartDate"
                               DateChanged="@(d => _rangeStartDate = d)"
                               Variant="Variant.Outlined"
                               Culture='@(new System.Globalization.CultureInfo("pt-BR"))'
                               DateFormat="dd/MM/yyyy"
                               MaxDate="DateTime.Today"
                               Style="min-width:150px"
                               Disabled="_isBusy" />
                <MudDatePicker Label="Até" Date="_rangeEndDate"
                               DateChanged="@(d => _rangeEndDate = d)"
                               Variant="Variant.Outlined"
                               Culture='@(new System.Globalization.CultureInfo("pt-BR"))'
                               DateFormat="dd/MM/yyyy"
                               MaxDate="DateTime.Today"
                               Style="min-width:150px"
                               Disabled="_isBusy" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="LoadByRangeAsync" Disabled="_isBusy"
                           StartIcon="@Icons.Material.Filled.Search">
                    Consultar
                </MudButton>
            </div>
        </div>

        <!-- ── KPI Cards ─────────────────────────────────────────────────────── -->
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Total de Ordens</p>
                        <p class="text-3xl font-bold text-[#750303]">@_metrics.TotalOrders</p>
                        <p class="text-xs text-gray-400">Ordens de reparo criadas</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Ordens Ativas</p>
                        <p class="text-3xl font-bold text-[#750303]">@_metrics.ActiveOrders</p>
                        <p class="text-xs text-gray-400">Não entregues</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Receita de Reparos</p>
                        <p class="text-3xl font-bold text-[#750303]">@FormatCurrency(_metrics.TotalRevenue)</p>
                        <p class="text-xs text-gray-400">Aprovado + consertado + entregue</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Taxa de Aprovação</p>
                        <p class="text-3xl font-bold text-[#750303]">@_metrics.ApprovalRate%</p>
                        <p class="text-xs text-gray-400">Orçamentos aprovados vs reprovados</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Tempo Médio de Ciclo</p>
                        <p class="text-3xl font-bold text-[#750303]">@_metrics.AverageCycleDays dias</p>
                        <p class="text-xs text-gray-400">Entrada até entrega</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Total de Vendas</p>
                        <p class="text-3xl font-bold text-[#750303]">@_metrics.TotalSales</p>
                        <p class="text-xs text-gray-400">Vendas realizadas</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Receita de Vendas</p>
                        <p class="text-3xl font-bold text-[#750303]">@FormatCurrency(_metrics.TotalSalesRevenue)</p>
                        <p class="text-xs text-gray-400">Total faturado em vendas</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">A Receber (Prontos Ainda Não Entregues)</p>
                        <p class="text-3xl font-bold text-[#750303]">@FormatCurrency(_metrics.PendingDeliveryRevenue)</p>
                        <p class="text-xs text-gray-400">Prontos ainda não entregues</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Gasto com Peças</p>
                        <p class="text-3xl font-bold text-[#750303]">@FormatCurrency(_metrics.TotalPartsSpend)</p>
                        <p class="text-xs text-gray-400">Peças dos produtos entregues no período</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Valor Total</p>
                        <p class="text-3xl font-bold text-[#750303]">@FormatCurrency(TotalRevenueCombined)</p>
                        <p class="text-xs text-gray-400">Receita de reparos + vendas</p>
                    </div>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Class="pa-4 h-full" Elevation="3">
                    <div class="flex flex-col gap-1">
                        <p class="text-xs font-sans text-gray-500 uppercase tracking-wide">Total Líquido</p>
                        <p class="text-3xl font-bold text-[#750303]">@FormatCurrency(NetTotal)</p>
                        <p class="text-xs text-gray-400">Valor total menos gasto com peças</p>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- ── Linha 1: Status (Donut) + Resultado reparos (Donut) ───────────── -->
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="3">
                    <p class="text-base font-bold font-sans text-[#750303] mb-3">Ordens por Status</p>
                    @if (_metrics.OrdersByStatusValues.Any(v => v > 0))
                    {
                        <MudChart ChartType="ChartType.Donut"
                                  InputData="@_metrics.OrdersByStatusValues.ToArray()"
                                  InputLabels="@_metrics.OrdersByStatusLabels.ToArray()"
                                  Width="100%" Height="300px" />
                    }
                    else
                    {
                        <p class="text-sm text-gray-400 text-center py-10">Sem dados no mês atual</p>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Elevation="3">
                    <p class="text-base font-bold font-sans text-[#750303] mb-3">Resultado dos Reparos</p>
                    @if (_metrics.RepairResultValues.Any(v => v > 0))
                    {
                        <MudChart ChartType="ChartType.Donut"
                                  InputData="@_metrics.RepairResultValues.ToArray()"
                                  InputLabels="@_metrics.RepairResultLabels.ToArray()"
                                  Width="100%" Height="300px" />
                    }
                    else
                    {
                        <p class="text-sm text-gray-400 text-center py-10">Sem dados no mês atual</p>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- ── Linha 2: Produtos Entregues no Período ──────────────────────────── -->
        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudPaper Class="pa-4" Elevation="3">
                    <p class="text-base font-bold font-sans text-[#750303] mb-3">
                        Produtos Entregues no Período (@_metrics.DeliveredProducts.Count)
                    </p>
                    @if (_metrics.DeliveredProducts.Any())
                    {
                        <MudTable Items="@_metrics.DeliveredProducts" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Ordem</p></MudTh>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Cliente</p></MudTh>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Produto</p></MudTh>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Tipo</p></MudTh>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Status</p></MudTh>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Empresa</p></MudTh>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Entregue em</p></MudTh>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Valor Total</p></MudTh>
                                <MudTh><p class="text-xs text-[#750303] font-bold uppercase">Valor da Peça</p></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Ordem">
                                    <p class="text-sm font-mono font-bold">#@context.Id</p>
                                </MudTd>
                                <MudTd DataLabel="Cliente">
                                    <p class="text-sm font-sans font-semibold uppercase">@context.CustomerName</p>
                                </MudTd>
                                <MudTd DataLabel="Produto">
                                    <p class="text-sm font-sans">@context.Brand @context.Model</p>
                                </MudTd>
                                <MudTd DataLabel="Tipo">
                                    <p class="text-sm font-sans">@context.TypeLabel</p>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(context.StatusLabel == "Venda" ? Color.Info : Color.Success)">
                                        @context.StatusLabel
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Empresa">
                                    <p class="text-sm font-sans">@context.EnterpriseLabel</p>
                                </MudTd>
                                <MudTd DataLabel="Entregue em">
                                    <p class="text-sm font-sans">@context.DeliveryDate.ToString("dd/MM/yyyy")</p>
                                </MudTd>
                                <MudTd DataLabel="Valor Total">
                                    <p class="text-sm font-sans">@FormatCurrency(context.TotalAmount)</p>
                                </MudTd>
                                <MudTd DataLabel="Valor da Peça">
                                    <MudNumericField T="decimal" Value="@context.PartPurchaseCost"
                                                      ValueChanged="@(v => SavePartPurchaseCostAsync(context, v))"
                                                      Immediate="false"
                                                      Variant="Variant.Outlined"
                                                      Adornment="Adornment.Start" AdornmentText="R$"
                                                      Min="0" Style="min-width:130px" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <p class="text-sm text-gray-400 text-center py-10">Sem produtos entregues no período</p>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

    }
</div>
