# Copie para .env (cp .env.example .env) e preencha. O .env nunca vai para o git.

# Endereço do sistema. Com um domínio, o Caddy emite o HTTPS sozinho (Let's Encrypt):
#   SITE_ADDRESS=gerenciamento.tvseletronica.com
# Sem domínio (só pelo IP, HTTP): deixe :80
SITE_ADDRESS=:80

# Portas da VPS usadas pelo sistema. Troque se a 80/443 já estiverem em uso (ex.: nginx de outro site):
#   HTTP_PORT=8080 -> acesso em http://IP_DA_VPS:8080 e http://IP_DA_VPS:8080/grafana
HTTP_PORT=80
HTTPS_PORT=443

# Banco de dados no Azure SQL (o mesmo do sistema antigo, se os dois forem rodar juntos).
# Pegue em: Portal do Azure > Banco SQL > Cadeias de conexão > ADO.NET. Libere o IP da VPS no firewall do servidor SQL.
DB_CONNECTION_STRING=Server=tcp:SEU_SERVIDOR.database.windows.net,1433;Initial Catalog=SEU_BANCO;User ID=SEU_USUARIO;Password=SUA_SENHA;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;ConnectRetryCount=3;ConnectRetryInterval=10;


# Login (JWT). Gere uma chave longa: openssl rand -base64 48
# Se os dois sistemas (antigo e novo) tiverem que aceitar o mesmo login, use a mesma chave/issuer/audience do antigo.
JWT_SECRET_KEY=
JWT_ISSUER=tvs-app
JWT_AUDIENCE=tvs-app

# Outros sites que chamam a API direto (separados por vírgula), ex.: o site público.
# O próprio sistema não precisa: ele chama a API pelo mesmo endereço (/api).
CORS_ORIGINS=https://www.tvseletronica.com

# WhatsApp (Evolution API)
# Evolution em outro servidor: EVOLUTION_BASE_URL=https://servidor-da-evolution (sem barra no final).
# Evolution nesta VPS (ver abaixo): EVOLUTION_BASE_URL=http://evolution-api:8080
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Número do dono para o envio REAL de teste, só sob demanda (só dígitos com DDD, ex.: 41999990000):
#   docker compose exec api curl -s -X POST localhost:8080/internal/whatsapp/test-message
WHATSAPP_TEST_PHONE=

# Opcional: subir a Evolution API junto, nesta VPS (containers evolution-api, -postgres e -redis).
# Ative com COMPOSE_PROFILES=whatsapp. A EVOLUTION_API_KEY acima vira a chave da própria Evolution.
# COMPOSE_PROFILES=whatsapp
# Senha do banco interno da Evolution (só na rede do Docker). Gere uma: openssl rand -base64 24
EVOLUTION_DB_PASSWORD=
# Porta do painel da Evolution (/manager), aberta só para a própria VPS (acesso por túnel SSH).
EVOLUTION_MANAGER_PORT=8090
# 127.0.0.1 = painel só pela própria VPS (túnel SSH). 0.0.0.0 = aberto em http://IP_DA_VPS:8090/manager
# — use só enquanto conecta o número e volte para 127.0.0.1 (quem tiver a chave controla o WhatsApp).
EVOLUTION_MANAGER_BIND=127.0.0.1

# Primeiro usuário: criado ao subir, só se ainda não existir esse e-mail. Pode apagar depois.
ADMIN_EMAIL=
ADMIN_PASSWORD=

ASPNETCORE_ENVIRONMENT=Production

# Observabilidade (Grafana com logs, métricas e alertas).
# Acesso sem DNS: http://IP_DA_VPS/grafana (ou https://SEU_DOMINIO/grafana) — não precisa configurar nada.
# Atenção: só pelo IP é HTTP, então a senha do Grafana trafega sem criptografia.
# Opcional: subdomínio próprio com HTTPS (registro A apontando para o IP da VPS). Deixe vazio se não usar.
GRAFANA_ADDRESS=
# Opcional: endereço completo do Grafana, usado em links absolutos (ex.: http://203.0.113.10/grafana/).
GRAFANA_ROOT_URL=
GRAFANA_ADMIN_USER=admin
# Obrigatória (a pilha não sobe sem ela). Gere uma forte: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
